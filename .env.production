# Production Configuration for AI Library

# Environment
ENVIRONMENT=production  # development, staging, production

# Application
APP_NAME=ai-library
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production

# API Keys (use environment variables in production)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Database
DATABASE_PATH=./data/books_metadata.db
VECTOR_DB_PATH=./data/books_index
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400  # 24 hours in seconds
MAX_BACKUPS=7

# API Server
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=4
API_TIMEOUT=300
CORS_ORIGINS=*  # Comma-separated list of allowed origins

# Security
ENABLE_AUTH=true
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_EXPIRY=3600  # 1 hour
API_KEY_HEADER=X-API-Key
ALLOWED_API_KEYS=  # Comma-separated list

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_BURST=10

# Caching
CACHE_ENABLED=true
CACHE_TYPE=redis  # redis, memory
CACHE_TTL=3600
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # text, json
LOG_FILE=./logs/production.log
LOG_MAX_SIZE=104857600  # 100MB
LOG_BACKUP_COUNT=10
ENABLE_SENTRY=false
SENTRY_DSN=

# Performance
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=300
ENABLE_COMPRESSION=true
CHUNK_BATCH_SIZE=50
EMBEDDING_BATCH_SIZE=32

# Storage
MAX_UPLOAD_SIZE=104857600  # 100MB
ALLOWED_EXTENSIONS=pdf,epub,mobi,txt,docx,html

# LLM Settings
DEFAULT_LLM_PROVIDER=local
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2

# Vector DB
VECTOR_DB_TYPE=faiss
VECTOR_DB_INDEX_TYPE=IndexFlatIP
SAVE_INTERVAL=1000

# Embeddings
EMBEDDING_MODEL=intfloat/e5-small-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=./models

# Alerts
ENABLE_ALERTS=false
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
